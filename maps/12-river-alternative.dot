edge[arrowsize="0.8", penwidth="1.7"]graph [bgcolor = "#ffffff" ]  n0 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KR3&#x20;&#xB7;&#x20;Tosafot&#x3A;&#x20;why&#x20;a&#x20;special<BR/>&#x20;verse&#x3F;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Known&#x20;despair&#x20;already<BR/>&#x20;permits&#x20;ordinary&#x20;loss.&#x20;A&#x20;river<BR/>&#x20;verse&#x20;confined&#x20;to&#x20;that&#x20;case<BR/>&#x20;would&#x20;add&#x20;nothing.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Known despair already permits ordinary loss. A river verse confined to that case would add nothing. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n1 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KR4&#x20;&#xB7;&#x20;Tosafot&#x3A;&#x20;what&#x20;the&#x20;exception<BR/>&#x20;adds</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;The&#x20;river&#x20;permission<BR/>&#x20;therefore&#x20;reaches&#x20;lack&#x20;of<BR/>&#x20;awareness&#x2C;&#x20;even&#x20;with&#x20;a&#x20;mark&#x20;and<BR/>&#x20;even&#x20;where&#x20;learning&#x20;would&#x20;not<BR/>&#x20;produce&#x20;despair.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · The river permission therefore reaches lack of awareness, even with a mark and even where learning would not produce despair. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n2 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>L1&#x20;&#xB7;&#x20;Rashba&#x3A;&#x20;another&#x20;purpose&#x20;for<BR/>&#x20;the&#x20;exception</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;The&#x20;special&#x20;permission&#x20;could<BR/>&#x20;concern&#x20;owners&#x20;pursuing&#x20;the<BR/>&#x20;object&#x20;and&#x20;expressly&#x20;refusing<BR/>&#x20;despair&#x3B;&#x20;ordinary&#x20;loss&#x20;without<BR/>&#x20;despair&#x20;could&#x20;still&#x20;be<BR/>&#x20;prohibited.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · The special permission could concern owners pursuing the object and expressly refusing despair; ordinary loss without despair could still be prohibited. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n3 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>L2&#x20;&#xB7;&#x20;Editorial&#x20;countermodel</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">R&#x20;&#xB7;&#x20;Permit&#x20;all&#x20;irrecoverable<BR/>&#x20;losses&#x20;and&#x20;ordinary&#x20;unmarked<BR/>&#x20;loss&#x20;before&#x20;awareness&#x2C;&#x20;as&#x20;Rava&#x3B;<BR/>&#x20;prohibit&#x20;ordinary&#x20;marked&#x20;loss<BR/>&#x20;before&#x20;actual&#x20;despair.<BR/>&#x20;Exception&#x20;permission&#x20;can<BR/>&#x20;coexist&#x20;with&#x20;Rava&#8217;s&#x20;position.&#x20;</FONT></TD></TR></TABLE>>, tooltip="R · Permit all irrecoverable losses and ordinary unmarked loss before awareness, as Rava; prohibit ordinary marked loss before actual despair. Exception permission can coexist with Rava’s position. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#f3d5a5", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n4 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>L3&#x20;&#xB7;&#x20;Ordinary&#x20;prohibition&#x20;&#x28;not<BR/>&#x20;yet&#x20;established&#x29;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">R&#x20;&#xB7;&#x20;Ordinary&#x20;unmarked&#x20;loss<BR/>&#x20;before&#x20;awareness&#x20;is&#x20;prohibited.<BR/>&#x20;The&#x20;tested&#x20;shortcut&#x20;does&#x20;not<BR/>&#x20;establish&#x20;this&#x20;conclusion&#x20;by<BR/>&#x20;itself.&#x20;</FONT></TD></TR></TABLE>>, tooltip="R · Ordinary unmarked loss before awareness is prohibited. The tested shortcut does not establish this conclusion by itself. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#f3d5a5", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n5 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>L4&#x20;&#xB7;&#x20;Rashba&#x3A;&#x20;read&#x20;from&#x20;the<BR/>&#x20;instant&#x20;of&#x20;loss</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Read&#x20;the&#x20;verse&#x20;as&#x20;addressing<BR/>&#x20;the&#x20;very&#x20;instant&#x20;of&#x20;loss&#x2C;<BR/>&#x20;whether&#x20;the&#x20;owner&#x20;knows&#x20;or&#x20;not.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Read the verse as addressing the very instant of loss, whether the owner knows or not. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n6 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>L5&#x20;&#xB7;&#x20;Rashba&#x3A;&#x20;explicit&#x20;comparative<BR/>&#x20;scope</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;At&#x20;that&#x20;instant&#x2C;&#x20;complete<BR/>&#x20;permission&#x20;is&#x20;stated&#x20;only&#x20;for<BR/>&#x20;loss&#x20;to&#x20;everyone&#x3B;&#x20;ordinary<BR/>&#x20;recoverable&#x20;loss&#x20;remains<BR/>&#x20;prohibited&#x2C;&#x20;including&#x20;unmarked<BR/>&#x20;loss.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · At that instant, complete permission is stated only for loss to everyone; ordinary recoverable loss remains prohibited, including unmarked loss. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n7 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>L6&#x20;&#xB7;&#x20;Rashba&#x3A;&#x20;ordinary&#x20;unawareness<BR/>&#x20;prohibited</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Under&#x20;Rashba&#8217;s&#x20;temporal<BR/>&#x20;reading&#x2C;&#x20;ordinary&#x20;unmarked&#x20;loss<BR/>&#x20;is&#x20;prohibited&#x20;before&#x20;awareness.<BR/>&#x20;This&#x20;records&#x20;his<BR/>&#x20;interpretation&#x2C;&#x20;not&#x20;a&#x20;machine<BR/>&#x20;proof.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Under Rashba’s temporal reading, ordinary unmarked loss is prohibited before awareness. This records his interpretation, not a machine proof. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n8 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>LA&#x20;&#xB7;&#x20;Redundancy-only&#x20;shortcut<BR/>&#x20;&#x28;tested&#x29;</B></FONT></TD></TR></TABLE>>, tooltip="LA · Redundancy-only shortcut (tested)", margin="0.16,0.12", shape="hexagon", style="filled", fillcolor="#f3d5a5", fontcolor="#000000",  type="argument-map-node"];
