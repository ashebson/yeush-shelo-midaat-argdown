subgraph cluster_1 {
  label = <<FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">Opening&#x20;and&#x20;scope</FONT>>;
  color = "#DADADA";
  margin="8" style = filled;
 labelloc = "t";

  n0 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>O1&#x20;&#xB7;&#x20;Scope&#x3A;&#x20;no&#x20;identifying&#x20;mark</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;The&#x20;dispute&#x20;concerns<BR/>&#x20;ordinary&#x20;lost&#x20;objects&#x20;without<BR/>&#x20;an&#x20;identifying&#x20;mark.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · The dispute concerns ordinary lost objects without an identifying mark. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n1 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>O2&#x20;&#xB7;&#x20;Marked&#x20;objects&#x3A;&#x20;agreement</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;Both&#x20;reject&#x20;unconscious<BR/>&#x20;yeush&#x20;here&#x3B;&#x20;later&#x20;despair&#x20;does<BR/>&#x20;not&#x20;repair&#x20;an&#x20;already<BR/>&#x20;prohibited&#x20;pickup.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · Both reject unconscious yeush here; later despair does not repair an already prohibited pickup. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n2 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>O3&#x20;&#xB7;&#x20;Sea&#x20;/&#x20;river&#x20;exception</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;The&#x20;Torah&#x20;permits&#x20;the<BR/>&#x20;exceptional&#x20;sea&#x20;or&#x20;river&#x20;loss&#x2C;<BR/>&#x20;even&#x20;with&#x20;a&#x20;mark.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · The Torah permits the exceptional sea or river loss, even with a mark. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n3 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>O4&#x20;&#xB7;&#x20;Abaye&#x3A;&#x20;no&#x20;awareness</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;The&#x20;owner&#x20;has&#x20;not&#x20;yet<BR/>&#x20;learned&#x20;of&#x20;the&#x20;loss.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · The owner has not yet learned of the loss. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n4 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>O5&#x20;&#xB7;&#x20;Abaye&#x3A;&#x20;ineffective</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;Unconscious&#x20;yeush&#x20;is&#x20;not<BR/>&#x20;effective&#x20;in&#x20;the&#x20;disputed&#x20;case.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · Unconscious yeush is not effective in the disputed case. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n5 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>O7&#x20;&#xB7;&#x20;Rava&#x3A;&#x20;effective&#x20;now</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;In&#x20;the&#x20;disputed&#x20;case&#x2C;&#x20;that<BR/>&#x20;anticipated&#x20;despair&#x20;counts&#x20;now.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · In the disputed case, that anticipated despair counts now. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n6 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>O6&#x20;&#xB7;&#x20;Rava&#x3A;&#x20;future&#x20;despair</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;Once&#x20;aware&#x2C;&#x20;the&#x20;owner&#x20;will<BR/>&#x20;despair&#x20;because&#x20;there&#x20;is&#x20;no<BR/>&#x20;identifying&#x20;mark.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · Once aware, the owner will despair because there is no identifying mark. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];

}


subgraph cluster_2 {
  label = <<FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">Coins&#x20;challenge&#x20;and&#x20;reply</FONT>>;
  color = "#DADADA";
  margin="8" style = filled;
 labelloc = "t";

  n7 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>C1&#x20;&#xB7;&#x20;Scattered&#x20;coins&#x3A;&#x20;permitted</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;The&#x20;cited&#x20;Mishnah&#x20;lets&#x20;the<BR/>&#x20;finder&#x20;keep&#x20;scattered&#x20;coins.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · The cited Mishnah lets the finder keep scattered coins. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n8 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>C2&#x20;&#xB7;&#x20;Objection&#x3A;&#x20;owner&#x20;unaware</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;The&#x20;objection&#x20;assumes&#x20;that<BR/>&#x20;the&#x20;owner&#x20;has&#x20;not&#x20;learned&#x20;of<BR/>&#x20;this&#x20;loss.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · The objection assumes that the owner has not learned of this loss. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n9 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>C3&#x20;&#xB7;&#x20;Bridge&#x3A;&#x20;test&#x20;Abaye</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">R&#x20;&#xB7;&#x20;If&#x20;permission&#x20;holds&#x20;while<BR/>&#x20;awareness&#x20;is&#x20;absent&#x2C;&#x20;this&#x20;case<BR/>&#x20;conflicts&#x20;with&#x20;Abaye.&#x20;</FONT></TD></TR></TABLE>>, tooltip="R · If permission holds while awareness is absent, this case conflicts with Abaye. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#f3d5a5", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n10 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>C5&#x20;&#xB7;&#x20;Reply&#x3A;&#x20;purse&#x20;checking</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;People&#x20;habitually&#x20;check<BR/>&#x20;their&#x20;purses&#x2C;&#x20;says&#x20;Rabbi<BR/>&#x20;Yitzhak.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · People habitually check their purses, says Rabbi Yitzhak. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n11 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>C6&#x20;&#xB7;&#x20;Owner&#x20;already&#x20;knew</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">E&#x20;&#xB7;&#x20;The&#x20;reply&#x20;treats&#x20;the&#x20;owner<BR/>&#x20;as&#x20;aware&#x20;and&#x20;despairing&#x20;before<BR/>&#x20;the&#x20;finder&#x20;picked&#x20;up&#x20;the&#x20;coins.&#x20;</FONT></TD></TR></TABLE>>, tooltip="E · The reply treats the owner as aware and despairing before the finder picked up the coins. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n12 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>C7&#x20;&#xB7;&#x20;Coins&#x20;do&#x20;not&#x20;decide</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">R&#x20;&#xB7;&#x20;With&#x20;unawareness&#x20;denied&#x2C;&#x20;the<BR/>&#x20;coins&#x20;case&#x20;does&#x20;not&#x20;establish<BR/>&#x20;Rava&#x20;over&#x20;Abaye.&#x20;</FONT></TD></TR></TABLE>>, tooltip="R · With unawareness denied, the coins case does not establish Rava over Abaye. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#f3d5a5", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n20 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>C4&#x20;&#xB7;&#x20;Coins&#x20;challenge</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">R&#x20;&#xB7;&#x20;Permission&#x20;plus&#x20;assumed<BR/>&#x20;unawareness&#x20;challenges&#x20;Abaye&#x2C;<BR/>&#x20;using&#x20;the&#x20;stated&#x20;bridge.&#x20;</FONT></TD></TR></TABLE>>, tooltip="R · Permission plus assumed unawareness challenges Abaye, using the stated bridge. ", margin="0.16,0.12", shape="hexagon", style="filled", fillcolor="#f3d5a5", fontcolor="#000000",  type="argument-map-node"];

}


subgraph cluster_3 {
  label = <<FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">Final&#x20;river&#x20;comparison</FONT>>;
  color = "#DADADA";
  margin="8" style = filled;
 labelloc = "t";

  n13 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R1&#x20;&#xB7;&#x20;Verse&#x3A;&#x20;loss&#x20;from&#x20;you</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;Deuteronomy&#x20;22&#x3A;3&#x20;is&#x20;read&#x20;as<BR/>&#x20;addressing&#x20;loss&#x20;from&#x20;the&#x20;owner<BR/>&#x20;that&#x20;remains&#x20;accessible&#x20;to<BR/>&#x20;others.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · Deuteronomy 22:3 is read as addressing loss from the owner that remains accessible to others. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n14 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R2&#x20;&#xB7;&#x20;Inaccessible&#x20;loss&#x3A;&#x20;permitted</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;A&#x20;river&#x20;loss&#x20;inaccessible&#x20;to<BR/>&#x20;everyone&#x20;is&#x20;excluded&#x20;from&#x20;that<BR/>&#x20;obligation.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · A river loss inaccessible to everyone is excluded from that obligation. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n15 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R3&#x20;&#xB7;&#x20;Compare&#x20;both&#x20;categories</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;The&#x20;Gemara&#x20;compares<BR/>&#x20;prohibition&#x20;and&#x20;permission&#x3A;<BR/>&#x20;each&#x20;covers&#x20;items&#x20;with&#x20;or<BR/>&#x20;without&#x20;a&#x20;mark.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · The Gemara compares prohibition and permission: each covers items with or without a mark. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n16 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R4&#x20;&#xB7;&#x20;Clarify&#x3A;&#x20;before&#x20;awareness</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">E&#x20;&#xB7;&#x20;For&#x20;the&#x20;ordinary-loss<BR/>&#x20;prohibition&#x2C;&#x20;the&#x20;owner&#x20;has&#x20;not<BR/>&#x20;learned&#x20;of&#x20;the&#x20;loss&#x20;before<BR/>&#x20;pickup.&#x20;</FONT></TD></TR></TABLE>>, tooltip="E · For the ordinary-loss prohibition, the owner has not learned of the loss before pickup. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n17 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R6&#x20;&#xB7;&#x20;Ordinary&#x20;loss&#x3A;&#x20;still<BR/>&#x20;prohibited</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">E&#x20;&#xB7;&#x20;In&#x20;that<BR/>&#x20;unaware-before-pickup&#x20;case&#x2C;<BR/>&#x20;ordinary&#x20;recoverable&#x20;loss&#x20;is<BR/>&#x20;prohibited&#x20;even&#x20;without&#x20;a&#x20;mark.&#x20;</FONT></TD></TR></TABLE>>, tooltip="E · In that unaware-before-pickup case, ordinary recoverable loss is prohibited even without a mark. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n18 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R7&#x20;&#xB7;&#x20;Rava&#x3A;&#x20;explicitly&#x20;refuted</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;The&#x20;Gemara&#x20;declares&#x20;the<BR/>&#x20;refutation&#x20;of&#x20;Rava&#x20;decisive.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · The Gemara declares the refutation of Rava decisive. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n19 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R8&#x20;&#xB7;&#x20;Ruling&#x3A;&#x20;follows&#x20;Abaye</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;The&#x20;text&#x20;rules&#x20;for&#x20;Abaye<BR/>&#x20;here&#x2C;&#x20;within&#x20;the&#x20;mnemonic&#x20;YAAL<BR/>&#x20;KAGAM.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · The text rules for Abaye here, within the mnemonic YAAL KAGAM. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n21 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R5&#x20;&#xB7;&#x20;River&#x20;comparison</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">R&#x20;&#xB7;&#x20;Apply&#x20;the&#x20;comparison&#x20;to<BR/>&#x20;ordinary&#x20;unmarked&#x20;loss&#x20;before<BR/>&#x20;awareness&#x3A;&#x20;anticipated&#x20;despair<BR/>&#x20;does&#x20;not&#x20;permit&#x20;it.&#x20;</FONT></TD></TR></TABLE>>, tooltip="R · Apply the comparison to ordinary unmarked loss before awareness: anticipated despair does not permit it. ", margin="0.16,0.12", shape="hexagon", style="filled", fillcolor="#f3d5a5", fontcolor="#000000",  type="argument-map-node"];

}



