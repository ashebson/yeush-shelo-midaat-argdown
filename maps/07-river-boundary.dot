edge[arrowsize="0.8", penwidth="1.7"]graph [bgcolor = "#ffffff" ]  n0 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KB1&#x20;&#xB7;&#x20;Rashba&#x3A;&#x20;scriptural<BR/>&#x20;ownerlessness</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;True&#x20;loss&#x20;to&#x20;everyone&#x20;is<BR/>&#x20;complete&#x20;ownerlessness&#x20;by&#x20;the<BR/>&#x20;Torah&#x2C;&#x20;even&#x20;if&#x20;the&#x20;owner<BR/>&#x20;pursues&#x20;it&#x20;and&#x20;expressly<BR/>&#x20;refuses&#x20;to&#x20;despair.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · True loss to everyone is complete ownerlessness by the Torah, even if the owner pursues it and expressly refuses to despair. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n1 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KB2&#x20;&#xB7;&#x20;Rashba&#x3A;&#x20;recoverability<BR/>&#x20;matters</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Siftable&#x20;sand&#x20;can&#x20;still<BR/>&#x20;yield&#x20;the&#x20;object.&#x20;On&#x20;hearing<BR/>&#x20;that&#x20;its&#x20;owner&#x20;has&#x20;not<BR/>&#x20;despaired&#x2C;&#x20;return&#x20;is&#x20;required&#x3B;<BR/>&#x20;it&#x20;is&#x20;not&#x20;fully&#x20;like&#x20;loss&#x20;to<BR/>&#x20;everyone.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Siftable sand can still yield the object. On hearing that its owner has not despaired, return is required; it is not fully like loss to everyone. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n2 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KB4&#x20;&#xB7;&#x20;Supplied&#x3A;&#x20;do&#x20;not&#x20;replace<BR/>&#x20;the&#x20;comparison</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">R&#x20;&#xB7;&#x20;This&#x20;account&#x20;limits&#x20;which<BR/>&#x20;losses&#x20;enter&#x20;the&#x20;exceptional<BR/>&#x20;category.&#x20;It&#x20;does&#x20;not&#x20;by&#x20;itself<BR/>&#x20;prove&#x20;the&#x20;ordinary&#x20;unawareness<BR/>&#x20;prohibition&#x20;in&#x20;the&#x20;final&#x20;river<BR/>&#x20;map.&#x20;</FONT></TD></TR></TABLE>>, tooltip="R · This account limits which losses enter the exceptional category. It does not by itself prove the ordinary unawareness prohibition in the final river map. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#f3d5a5", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n3 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KB3&#x20;&#xB7;&#x20;Supplied&#x3A;&#x20;keep&#x20;the<BR/>&#x20;exceptional&#x20;scope</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">R&#x20;&#xB7;&#x20;Rashba&#x20;sharpens&#x20;the&#x20;base<BR/>&#x20;scope&#x20;note&#x3A;&#x20;psychological<BR/>&#x20;despair&#x20;does&#x20;not&#x20;create&#x20;this<BR/>&#x20;exceptional&#x20;permission&#x2C;&#x20;and&#x20;a<BR/>&#x20;river&#x20;location&#x20;alone&#x20;does&#x20;not<BR/>&#x20;establish&#x20;it.&#x20;</FONT></TD></TR></TABLE>>, tooltip="R · Rashba sharpens the base scope note: psychological despair does not create this exceptional permission, and a river location alone does not establish it. ", margin="0.16,0.12", shape="hexagon", style="filled", fillcolor="#f3d5a5", fontcolor="#000000",  type="argument-map-node"];


