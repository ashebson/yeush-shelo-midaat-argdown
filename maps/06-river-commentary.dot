edge[arrowsize="0.8", penwidth="1.7"]graph [bgcolor = "#ffffff" ]  n0 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KR1&#x20;&#xB7;&#x20;Rashi&#x3A;&#x20;the&#x20;same&#x20;verse</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Ordinary&#x20;return&#x20;and<BR/>&#x20;exceptional&#x20;acquisition&#x20;come<BR/>&#x20;from&#x20;one&#x20;verse&#x2C;&#x20;warranting<BR/>&#x20;their&#x20;comparison.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Ordinary return and exceptional acquisition come from one verse, warranting their comparison. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n1 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KR2&#x20;&#xB7;&#x20;Rashi&#x3A;&#x20;the&#x20;timing&#x20;limit</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Ordinary&#x20;unmarked&#x20;loss&#x20;is<BR/>&#x20;prohibited&#x20;here&#x20;when&#x20;the&#x20;owner<BR/>&#x20;may&#x20;not&#x20;have&#x20;learned&#x20;of&#x20;the<BR/>&#x20;loss&#x20;before&#x20;the&#x20;finder&#x20;took&#x20;it.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Ordinary unmarked loss is prohibited here when the owner may not have learned of the loss before the finder took it. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n2 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KR3&#x20;&#xB7;&#x20;Tosafot&#x3A;&#x20;why&#x20;a&#x20;special<BR/>&#x20;verse&#x3F;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Known&#x20;despair&#x20;already<BR/>&#x20;permits&#x20;ordinary&#x20;loss.&#x20;A&#x20;river<BR/>&#x20;verse&#x20;confined&#x20;to&#x20;that&#x20;case<BR/>&#x20;would&#x20;add&#x20;nothing.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Known despair already permits ordinary loss. A river verse confined to that case would add nothing. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n3 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KR4&#x20;&#xB7;&#x20;Tosafot&#x3A;&#x20;what&#x20;the&#x20;exception<BR/>&#x20;adds</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;The&#x20;river&#x20;permission<BR/>&#x20;therefore&#x20;reaches&#x20;lack&#x20;of<BR/>&#x20;awareness&#x2C;&#x20;even&#x20;with&#x20;a&#x20;mark&#x20;and<BR/>&#x20;even&#x20;where&#x20;learning&#x20;would&#x20;not<BR/>&#x20;produce&#x20;despair.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · The river permission therefore reaches lack of awareness, even with a mark and even where learning would not produce despair. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n4 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KR5&#x20;&#xB7;&#x20;Tosafot&#x3A;&#x20;carry&#x20;across&#x20;the<BR/>&#x20;comparison</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;The&#x20;ordinary&#x20;prohibition<BR/>&#x20;likewise&#x20;covers&#x20;absence&#x20;of<BR/>&#x20;known&#x20;despair&#x2C;&#x20;with&#x20;or&#x20;without<BR/>&#x20;a&#x20;mark&#x3B;&#x20;prior&#x20;despair&#x20;before<BR/>&#x20;pickup&#x20;remains&#x20;the&#x20;route&#x20;to<BR/>&#x20;permission.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · The ordinary prohibition likewise covers absence of known despair, with or without a mark; prior despair before pickup remains the route to permission. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n5 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KR7&#x20;&#xB7;&#x20;Tosafot&#x3A;&#x20;Rava&#x20;knew&#x20;the<BR/>&#x20;baraita</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Rava&#x20;knew&#x20;the&#x20;river&#x20;source<BR/>&#x20;but&#x20;had&#x20;not&#x20;drawn&#x20;the<BR/>&#x20;prohibition&#8211;permission<BR/>&#x20;comparison.&#x20;This&#x20;explains&#x20;the<BR/>&#x20;refutation&#x2C;&#x20;rather&#x20;than&#x20;adding<BR/>&#x20;a&#x20;proof.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Rava knew the river source but had not drawn the prohibition–permission comparison. This explains the refutation, rather than adding a proof. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n6 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KR6&#x20;&#xB7;&#x20;Supplied&#x3A;&#x20;make&#x20;the&#x20;extra<BR/>&#x20;premise&#x20;visible&#x20;-&#x20;1</B></FONT></TD></TR></TABLE>>, tooltip="KR6 · Supplied: make the extra premise visible - 1", margin="0.16,0.12", shape="hexagon", style="filled", fillcolor="#f3d5a5", fontcolor="#000000",  type="argument-map-node"];
  n7 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KR6&#x20;&#xB7;&#x20;Supplied&#x3A;&#x20;make&#x20;the&#x20;extra<BR/>&#x20;premise&#x20;visible&#x20;-&#x20;2</B></FONT></TD></TR></TABLE>>, tooltip="KR6 · Supplied: make the extra premise visible - 2", margin="0.16,0.12", shape="hexagon", style="filled", fillcolor="#f3d5a5", fontcolor="#000000",  type="argument-map-node"];


