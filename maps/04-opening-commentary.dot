edge[arrowsize="0.8", penwidth="1.7"]graph [bgcolor = "#ffffff" ]  n0 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KO1&#x20;&#xB7;&#x20;Rashi&#x3A;&#x20;the&#x20;time&#x20;of&#x20;discovery</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;At&#x20;discovery&#x20;the&#x20;owner&#x20;is<BR/>&#x20;unaware&#x2C;&#x20;although&#x20;learning&#x20;of<BR/>&#x20;the&#x20;loss&#x20;would&#x20;normally&#x20;bring<BR/>&#x20;despair.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · At discovery the owner is unaware, although learning of the loss would normally bring despair. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n1 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KO2&#x20;&#xB7;&#x20;Rashi&#x3A;&#x20;explaining&#x20;Rava</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Rava&#x20;counts&#x20;the&#x20;response<BR/>&#x20;now&#x3A;&#x20;once&#x20;the&#x20;owner&#x20;learns&#x2C;&#x20;the<BR/>&#x20;lost&#x20;object&#x20;will&#x20;no&#x20;longer<BR/>&#x20;occupy&#x20;the&#x20;owner&#8217;s&#x20;concern.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Rava counts the response now: once the owner learns, the lost object will no longer occupy the owner’s concern. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n2 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KO3&#x20;&#xB7;&#x20;Tosafot&#x3A;&#x20;marked&#x20;loss&#x20;is<BR/>&#x20;different</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Later&#x20;despair&#x20;over&#x20;a&#x20;marked<BR/>&#x20;object&#x20;is&#x20;contingent&#x3B;&#x20;initially<BR/>&#x20;the&#x20;owner&#x20;was&#x20;not&#x20;standing<BR/>&#x20;ready&#x20;to&#x20;despair.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Later despair over a marked object is contingent; initially the owner was not standing ready to despair. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n3 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KO4&#x20;&#xB7;&#x20;Ritva&#x20;&#x28;via&#x20;Shittah&#x29;&#x3A;<BR/>&#x20;possession&#x20;for&#x20;the&#x20;owner</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Where&#x20;unnoticed&#x20;despair&#x20;is<BR/>&#x20;ineffective&#x2C;&#x20;pickup&#x20;leaves&#x20;the<BR/>&#x20;finder&#8217;s&#x20;hand&#x20;like&#x20;the&#x20;owner&#8217;s<BR/>&#x20;hand&#x2C;&#x20;as&#x20;a&#x20;custodian.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Where unnoticed despair is ineffective, pickup leaves the finder’s hand like the owner’s hand, as a custodian. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n4 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KO5&#x20;&#xB7;&#x20;Ritva&#x20;&#x28;via&#x20;Shittah&#x29;&#x3A;&#x20;later<BR/>&#x20;despair&#x20;cannot&#x20;cure&#x20;it</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Because&#x20;the&#x20;finder&#x20;did&#x20;not<BR/>&#x20;acquire&#x20;at&#x20;pickup&#x20;and&#x20;holds&#x20;for<BR/>&#x20;the&#x20;owner&#x2C;&#x20;the&#x20;owner&#8217;s&#x20;later<BR/>&#x20;despair&#x20;does&#x20;not&#x20;confer<BR/>&#x20;acquisition.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Because the finder did not acquire at pickup and holds for the owner, the owner’s later despair does not confer acquisition. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n5 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KO6&#x20;&#xB7;&#x20;Ritva&#x20;&#x28;via&#x20;Shittah&#x29;&#x3A;&#x20;not<BR/>&#x20;necessarily&#x20;theft</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Ba-issura&#x20;here&#x20;describes<BR/>&#x20;taking&#x20;while&#x20;the&#x20;object&#x20;remains<BR/>&#x20;in&#x20;the&#x20;owner&#8217;s&#x20;domain&#x3B;&#x20;it&#x20;need<BR/>&#x20;not&#x20;mean&#x20;an&#x20;intention&#x20;to&#x20;steal.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Ba-issura here describes taking while the object remains in the owner’s domain; it need not mean an intention to steal. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n6 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KO7&#x20;&#xB7;&#x20;Supplied&#x3A;&#x20;two&#x20;distinct<BR/>&#x20;qualifications</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">R&#x20;&#xB7;&#x20;Keep&#x20;anticipated&#x20;despair<BR/>&#x20;separate&#x20;from&#x20;contingent&#x20;later<BR/>&#x20;despair&#x2C;&#x20;and&#x20;ask&#x20;whether&#x20;pickup<BR/>&#x20;already&#x20;made&#x20;the&#x20;finder&#x20;a<BR/>&#x20;holder&#x20;for&#x20;the&#x20;owner.&#x20;</FONT></TD></TR></TABLE>>, tooltip="R · Keep anticipated despair separate from contingent later despair, and ask whether pickup already made the finder a holder for the owner. ", margin="0.16,0.12", shape="hexagon", style="filled", fillcolor="#f3d5a5", fontcolor="#000000",  type="argument-map-node"];


