edge[arrowsize="0.8", penwidth="1.7"]graph [bgcolor = "#ffffff" ]  n0 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R2&#x20;&#xB7;&#x20;Inaccessible&#x20;loss&#x3A;&#x20;permitted</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;A&#x20;river&#x20;loss&#x20;inaccessible&#x20;to<BR/>&#x20;everyone&#x20;is&#x20;excluded&#x20;from&#x20;that<BR/>&#x20;obligation.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · A river loss inaccessible to everyone is excluded from that obligation. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n1 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>KR1&#x20;&#xB7;&#x20;Rashi&#x3A;&#x20;the&#x20;same&#x20;verse</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Ordinary&#x20;return&#x20;and<BR/>&#x20;exceptional&#x20;acquisition&#x20;come<BR/>&#x20;from&#x20;one&#x20;verse&#x2C;&#x20;warranting<BR/>&#x20;their&#x20;comparison.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Ordinary return and exceptional acquisition come from one verse, warranting their comparison. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n2 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R9&#x20;&#xB7;&#x20;Supplied&#x3A;&#x20;scope&#x20;of&#x20;the<BR/>&#x20;comparison</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">R&#x20;&#xB7;&#x20;The&#x20;comparison&#x20;places<BR/>&#x20;ordinary&#x20;recoverable&#x20;loss&#x20;under<BR/>&#x20;the&#x20;prohibition&#x20;with&#x20;or&#x20;without<BR/>&#x20;a&#x20;mark&#x2C;&#x20;within&#x20;that<BR/>&#x20;prohibition&#8217;s&#x20;temporal&#x20;scope.&#x20;</FONT></TD></TR></TABLE>>, tooltip="R · The comparison places ordinary recoverable loss under the prohibition with or without a mark, within that prohibition’s temporal scope. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#f3d5a5", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n3 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>J1&#x20;&#xB7;&#x20;Ritva&#x20;reports&#x3A;&#x20;no&#x20;explicit<BR/>&#x20;juxtaposition</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;The&#x20;verse&#x20;does&#x20;not&#x20;state&#x20;the<BR/>&#x20;permission&#x20;alongside&#x20;the<BR/>&#x20;prohibition&#x3B;&#x20;it&#x20;excludes&#x20;the<BR/>&#x20;inaccessible&#x20;case&#x20;from&#x20;the<BR/>&#x20;prohibition.&#x20;Ritva&#x20;records&#x20;this<BR/>&#x20;objection&#x20;as&#x20;coming&#x20;from<BR/>&#x20;Tosafot.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · The verse does not state the permission alongside the prohibition; it excludes the inaccessible case from the prohibition. Ritva records this objection as coming from Tosafot. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n4 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>J4&#x20;&#xB7;&#x20;Tested&#x20;bridge&#x3A;&#x20;transfer<BR/>&#x20;every&#x20;condition</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">R&#x20;&#xB7;&#x20;Suppose&#x20;the&#x20;comparison<BR/>&#x20;transfers&#x20;all&#x20;awareness&#x20;and<BR/>&#x20;despair&#x20;conditions&#x20;unchanged<BR/>&#x20;from&#x20;exceptional&#x20;permission&#x20;to<BR/>&#x20;ordinary&#x20;prohibition.&#x20;</FONT></TD></TR></TABLE>>, tooltip="R · Suppose the comparison transfers all awareness and despair conditions unchanged from exceptional permission to ordinary prohibition. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#f3d5a5", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n5 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>J2&#x20;&#xB7;&#x20;Ritva&#x20;reports&#x3A;&#x20;unrestricted<BR/>&#x20;transfer&#x20;overreaches</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;If&#x20;every&#x20;condition&#x20;were<BR/>&#x20;transferred&#x2C;&#x20;ordinary&#x20;loss<BR/>&#x20;would&#x20;remain&#x20;prohibited&#x20;even<BR/>&#x20;after&#x20;actual&#x20;despair.&#x20;Ritva<BR/>&#x20;records&#x20;this&#x20;objection&#x20;as<BR/>&#x20;coming&#x20;from&#x20;Tosafot.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · If every condition were transferred, ordinary loss would remain prohibited even after actual despair. Ritva records this objection as coming from Tosafot. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n6 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>J5&#x20;&#xB7;&#x20;Overextended&#x20;result&#x20;&#x28;not<BR/>&#x20;adopted&#x29;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">R&#x20;&#xB7;&#x20;Ordinary&#x20;loss&#x20;would&#x20;be<BR/>&#x20;prohibited&#x20;even&#x20;after&#x20;actual<BR/>&#x20;despair.&#x20;This&#x20;is&#x20;the<BR/>&#x20;consequence&#x20;challenged&#x20;by&#x20;the<BR/>&#x20;reported&#x20;objection&#x2C;&#x20;not&#x20;Rashi&#8217;s<BR/>&#x20;qualified&#x20;conclusion.&#x20;</FONT></TD></TR></TABLE>>, tooltip="R · Ordinary loss would be prohibited even after actual despair. This is the consequence challenged by the reported objection, not Rashi’s qualified conclusion. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#f3d5a5", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n7 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>J3&#x20;&#xB7;&#x20;Ritva&#x3A;&#x20;prior&#x20;actual&#x20;despair<BR/>&#x20;can&#x20;permit</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;For&#x20;ordinary&#x20;loss&#x2C;&#x20;actual<BR/>&#x20;despair&#x20;before&#x20;pickup&#x20;can<BR/>&#x20;permit&#x20;acquisition&#x2C;&#x20;including&#x20;a<BR/>&#x20;marked&#x20;object&#x20;whose&#x20;owner<BR/>&#x20;knowingly&#x20;despairs.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · For ordinary loss, actual despair before pickup can permit acquisition, including a marked object whose owner knowingly despairs. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n8 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>J6&#x20;&#xB7;&#x20;Ritva&#x3A;&#x20;finding&#x20;immediately<BR/>&#x20;after&#x20;loss</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Read&#x20;loss&#x20;and&#x20;finding<BR/>&#x20;together&#x3A;&#x20;the&#x20;verse&#x20;addresses&#x20;a<BR/>&#x20;find&#x20;immediately&#x20;following&#x20;the<BR/>&#x20;loss&#x2C;&#x20;before&#x20;the&#x20;owner&#x20;knows.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Read loss and finding together: the verse addresses a find immediately following the loss, before the owner knows. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n9 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>J7&#x20;&#xB7;&#x20;Ritva&#x3A;&#x20;only&#x20;irrecoverability<BR/>&#x20;exempted&#x20;here</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;In&#x20;that&#x20;unaware-at-finding<BR/>&#x20;case&#x2C;&#x20;the&#x20;verse&#x20;opens<BR/>&#x20;permission&#x20;only&#x20;for&#x20;loss&#x20;to<BR/>&#x20;everyone&#x3B;&#x20;the&#x20;ordinary<BR/>&#x20;prohibition&#x20;also&#x20;covers<BR/>&#x20;unmarked&#x20;loss.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · In that unaware-at-finding case, the verse opens permission only for loss to everyone; the ordinary prohibition also covers unmarked loss. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n10 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>J8&#x20;&#xB7;&#x20;Ritva&#x3A;&#x20;prior-awareness<BR/>&#x20;permission&#x20;is&#x20;separate</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;Permission&#x20;after&#x20;the&#x20;owner<BR/>&#x20;knows&#x2C;&#x20;for&#x20;an&#x20;unmarked&#x20;loss&#x2C;&#x20;is<BR/>&#x20;derived&#x20;separately&#x20;from&#x20;the<BR/>&#x20;garment&#x20;passage&#x20;&#x28;simlah&#x29;.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · Permission after the owner knows, for an unmarked loss, is derived separately from the garment passage (simlah). ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n11 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>J9&#x20;&#xB7;&#x20;Ritva&#x3A;&#x20;prohibition&#x20;before<BR/>&#x20;awareness</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">C&#x20;&#xB7;&#x20;On&#x20;this&#x20;reading&#x2C;&#x20;ordinary<BR/>&#x20;unmarked&#x20;loss&#x20;found&#x20;before<BR/>&#x20;awareness&#x20;is&#x20;prohibited&#x3B;<BR/>&#x20;established&#x20;prior&#x20;despair<BR/>&#x20;remains&#x20;outside&#x20;that&#x20;temporal<BR/>&#x20;case.&#x20;</FONT></TD></TR></TABLE>>, tooltip="C · On this reading, ordinary unmarked loss found before awareness is prohibited; established prior despair remains outside that temporal case. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n12 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>JA&#x20;&#xB7;&#x20;Proposed&#x20;same-verse<BR/>&#x20;comparison</B></FONT></TD></TR></TABLE>>, tooltip="JA · Proposed same-verse comparison", margin="0.16,0.12", shape="hexagon", style="filled", fillcolor="#f3d5a5", fontcolor="#000000",  type="argument-map-node"];
  n13 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>JD&#x20;&#xB7;&#x20;Unrestricted&#x20;extension<BR/>&#x20;&#x28;tested&#x29;</B></FONT></TD></TR></TABLE>>, tooltip="JD · Unrestricted extension (tested)", margin="0.16,0.12", shape="hexagon", style="filled", fillcolor="#f3d5a5", fontcolor="#000000",  type="argument-map-node"];
