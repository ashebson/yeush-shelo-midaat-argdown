edge[arrowsize="0.8", penwidth="1.7"]graph [bgcolor = "#ffffff" ]  n0 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R1&#x20;&#xB7;&#x20;Verse&#x3A;&#x20;loss&#x20;from&#x20;you</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;Deuteronomy&#x20;22&#x3A;3&#x20;is&#x20;read&#x20;as<BR/>&#x20;addressing&#x20;loss&#x20;from&#x20;the&#x20;owner<BR/>&#x20;that&#x20;remains&#x20;accessible&#x20;to<BR/>&#x20;others.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · Deuteronomy 22:3 is read as addressing loss from the owner that remains accessible to others. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n1 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R2&#x20;&#xB7;&#x20;Inaccessible&#x20;loss&#x3A;&#x20;permitted</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;A&#x20;river&#x20;loss&#x20;inaccessible&#x20;to<BR/>&#x20;everyone&#x20;is&#x20;excluded&#x20;from&#x20;that<BR/>&#x20;obligation.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · A river loss inaccessible to everyone is excluded from that obligation. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n2 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R3&#x20;&#xB7;&#x20;Compare&#x20;both&#x20;categories</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;The&#x20;Gemara&#x20;compares<BR/>&#x20;prohibition&#x20;and&#x20;permission&#x3A;<BR/>&#x20;each&#x20;covers&#x20;items&#x20;with&#x20;or<BR/>&#x20;without&#x20;a&#x20;mark.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · The Gemara compares prohibition and permission: each covers items with or without a mark. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n3 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R4&#x20;&#xB7;&#x20;Clarify&#x3A;&#x20;before&#x20;awareness</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">E&#x20;&#xB7;&#x20;For&#x20;the&#x20;ordinary-loss<BR/>&#x20;prohibition&#x2C;&#x20;the&#x20;owner&#x20;has&#x20;not<BR/>&#x20;learned&#x20;of&#x20;the&#x20;loss&#x20;before<BR/>&#x20;pickup.&#x20;</FONT></TD></TR></TABLE>>, tooltip="E · For the ordinary-loss prohibition, the owner has not learned of the loss before pickup. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n4 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R9&#x20;&#xB7;&#x20;Supplied&#x3A;&#x20;scope&#x20;of&#x20;the<BR/>&#x20;comparison</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">R&#x20;&#xB7;&#x20;The&#x20;comparison&#x20;places<BR/>&#x20;ordinary&#x20;recoverable&#x20;loss&#x20;under<BR/>&#x20;the&#x20;prohibition&#x20;with&#x20;or&#x20;without<BR/>&#x20;a&#x20;mark&#x2C;&#x20;within&#x20;that<BR/>&#x20;prohibition&#8217;s&#x20;temporal&#x20;scope.&#x20;</FONT></TD></TR></TABLE>>, tooltip="R · The comparison places ordinary recoverable loss under the prohibition with or without a mark, within that prohibition’s temporal scope. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#f3d5a5", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n5 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R6&#x20;&#xB7;&#x20;Ordinary&#x20;loss&#x3A;&#x20;still<BR/>&#x20;prohibited</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">E&#x20;&#xB7;&#x20;In&#x20;that<BR/>&#x20;unaware-before-pickup&#x20;case&#x2C;<BR/>&#x20;ordinary&#x20;recoverable&#x20;loss&#x20;is<BR/>&#x20;prohibited&#x20;even&#x20;without&#x20;a&#x20;mark.&#x20;</FONT></TD></TR></TABLE>>, tooltip="E · In that unaware-before-pickup case, ordinary recoverable loss is prohibited even without a mark. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n6 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R7&#x20;&#xB7;&#x20;Rava&#x3A;&#x20;explicitly&#x20;refuted</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;The&#x20;Gemara&#x20;declares&#x20;the<BR/>&#x20;refutation&#x20;of&#x20;Rava&#x20;decisive.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · The Gemara declares the refutation of Rava decisive. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n7 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>R8&#x20;&#xB7;&#x20;Ruling&#x3A;&#x20;follows&#x20;Abaye</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;The&#x20;text&#x20;rules&#x20;for&#x20;Abaye<BR/>&#x20;here&#x2C;&#x20;within&#x20;the&#x20;mnemonic&#x20;YAAL<BR/>&#x20;KAGAM.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · The text rules for Abaye here, within the mnemonic YAAL KAGAM. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
