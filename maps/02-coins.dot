edge[arrowsize="0.8", penwidth="1.7"]graph [bgcolor = "#ffffff" ]  n0 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>C1&#x20;&#xB7;&#x20;Scattered&#x20;coins&#x3A;&#x20;permitted</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;The&#x20;cited&#x20;Mishnah&#x20;lets&#x20;the<BR/>&#x20;finder&#x20;keep&#x20;scattered&#x20;coins.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · The cited Mishnah lets the finder keep scattered coins. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n1 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>C2&#x20;&#xB7;&#x20;Objection&#x3A;&#x20;owner&#x20;unaware</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;The&#x20;objection&#x20;assumes&#x20;that<BR/>&#x20;the&#x20;owner&#x20;has&#x20;not&#x20;learned&#x20;of<BR/>&#x20;this&#x20;loss.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · The objection assumes that the owner has not learned of this loss. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n2 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>C3&#x20;&#xB7;&#x20;Bridge&#x3A;&#x20;test&#x20;Abaye</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">R&#x20;&#xB7;&#x20;If&#x20;permission&#x20;holds&#x20;while<BR/>&#x20;awareness&#x20;is&#x20;absent&#x2C;&#x20;this&#x20;case<BR/>&#x20;conflicts&#x20;with&#x20;Abaye.&#x20;</FONT></TD></TR></TABLE>>, tooltip="R · If permission holds while awareness is absent, this case conflicts with Abaye. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#f3d5a5", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n3 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>C5&#x20;&#xB7;&#x20;Reply&#x3A;&#x20;purse&#x20;checking</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">S&#x20;&#xB7;&#x20;People&#x20;habitually&#x20;check<BR/>&#x20;their&#x20;purses&#x2C;&#x20;says&#x20;Rabbi<BR/>&#x20;Yitzhak.&#x20;</FONT></TD></TR></TABLE>>, tooltip="S · People habitually check their purses, says Rabbi Yitzhak. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#267565", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n4 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>C6&#x20;&#xB7;&#x20;Owner&#x20;already&#x20;knew</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">E&#x20;&#xB7;&#x20;The&#x20;reply&#x20;treats&#x20;the&#x20;owner<BR/>&#x20;as&#x20;aware&#x20;and&#x20;despairing&#x20;before<BR/>&#x20;the&#x20;finder&#x20;picked&#x20;up&#x20;the&#x20;coins.&#x20;</FONT></TD></TR></TABLE>>, tooltip="E · The reply treats the owner as aware and despairing before the finder picked up the coins. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#53659c", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n5 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000"><B>C7&#x20;&#xB7;&#x20;Coins&#x20;do&#x20;not&#x20;decide</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="14" COLOR="#000000">R&#x20;&#xB7;&#x20;With&#x20;unawareness&#x20;denied&#x2C;&#x20;the<BR/>&#x20;coins&#x20;case&#x20;does&#x20;not&#x20;establish<BR/>&#x20;Rava&#x20;over&#x20;Abaye.&#x20;</FONT></TD></TR></TABLE>>, tooltip="R · With unawareness denied, the coins case does not establish Rava over Abaye. ", shape="box",  margin="0.16,0.12", style="rounded,filled", color="#f3d5a5", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
